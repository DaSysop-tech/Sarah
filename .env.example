# Copy this file to .env and fill in your own values.

# Port the server listens on
PORT=3000

# Optional: enables real conversational intelligence via OpenAI.
# Without this, Sarah still works using warm, rule-based responses.
OPENAI_API_KEY=

# Chat model used for Sarah's conversation (needs OPENAI_API_KEY).
# gpt-4.1-mini is a fast, natural default. For an even smarter, more
# nuanced conversationalist, try gpt-5.6-terra (balanced) or gpt-5.6-sol
# (most capable) — the server automatically adjusts request parameters
# for these newer reasoning-tier models, no other changes needed.
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Text-to-speech model + voice used for Sarah's spoken replies (needs OPENAI_API_KEY)
# Only used if ELEVENLABS_API_KEY below is not set — see the note there.
# Voice options: alloy, echo, fable, onyx, nova, shimmer, coral, sage
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# Optional but recommended: gives Sarah a genuinely breathy, human voice
# instead of a robotic text-to-speech read. When set, this takes priority
# over the OpenAI voice above. Get a free key at https://elevenlabs.io.
ELEVENLABS_API_KEY=

# Defaults to ElevenLabs' own "Sarah" voice (soft, young, female) if unset.
# Browse elevenlabs.io/app/voice-library and filter by "Breathy" for more
# options (e.g. search "Mira", "Karla", "Filiz", "Diana"), then paste the
# voice's ID here. Some shared library voices need to be added to your
# ElevenLabs account first (click "Add to my voices" on its library page).
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# eleven_turbo_v2_5 keeps latency low for live conversation. For maximum
# expressiveness (at higher latency), try eleven_multilingual_v2 or eleven_v3.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Lower stability + higher style push the delivery to be more breathy and
# emotionally expressive; raise stability if it starts sounding unstable.
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.45
