# Copy this file to .env and fill in your own values.

# Port the server listens on
PORT=3000

# Optional: enables real conversational intelligence via OpenAI.
# Without this, Sarah still works using warm, rule-based responses.
OPENAI_API_KEY=

# Chat model used for Sarah's conversation (needs OPENAI_API_KEY)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Text-to-speech model + voice used for Sarah's spoken replies (needs OPENAI_API_KEY)
# Voice options: alloy, echo, fable, onyx, nova, shimmer, coral, sage
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer
